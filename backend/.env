# Configuração do Pokémon Card Scanner
# Copie este arquivo para .env e preencha com seus valores

# Porta do servidor
PORT=5000

# Token da API do MYP Cards (obrigatório para consultas de preço)
# Solicite acesso em: https://mypcards.com/acesso-api
MYPCARDS_API_TOKEN=

# URL base da API do MYP Cards
MYPCARDS_API_BASE_URL=https://api.mypcards.com

# Limite de requisições por minuto (sem token: 10, com token: 60)
MYPCARDS_RATE_LIMIT=10
