# Configuração do Pokémon Card Scanner
# Copie este arquivo para .env e preencha com seus valores

# Porta do servidor
PORT=5000

# Chave da API da Anthropic (obrigatória para identificar a carta pela foto)
# Crie em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado na identificação (padrão: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# 1 = HTTPS com certificado autoassinado (câmera no Android pela rede local)
HTTPS=0

# 1 = modo debug do Flask (NUNCA use na rede/publicado)
FLASK_DEBUG=0
